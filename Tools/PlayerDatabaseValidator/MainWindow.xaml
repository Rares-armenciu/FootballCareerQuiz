<Window x:Class="PlayerDatabaseValidator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Player Database Validator" Height="650" Width="1000">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <Button x:Name="LoadButton" Content="Open JSON File..." Padding="10,5" Click="LoadButton_Click" />
            <Button x:Name="RemoveButton" Content="Remove Selected" Padding="10,5" Margin="10,0,0,0" IsEnabled="False" Click="RemoveButton_Click" />
            <Button x:Name="SaveButton" Content="Save Changes" Padding="10,5" Margin="10,0,0,0" IsEnabled="False" Click="SaveButton_Click" />
            <TextBlock x:Name="FilePathText" Text="No file loaded" VerticalAlignment="Center" Margin="15,0,0,0" Foreground="Gray" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBlock x:Name="PlayerCountText" Text="Players: 0" FontWeight="Bold" Margin="0,0,20,0" />
            <TextBlock x:Name="ValidCountText" Text="Valid: 0" Foreground="Green" Margin="0,0,20,0" />
            <TextBlock x:Name="WarningCountText" Text="Warnings: 0" Foreground="DarkOrange" Margin="0,0,20,0" />
            <TextBlock x:Name="ErrorCountText" Text="Errors: 0" Foreground="Red" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.ColumnSpan="3" Margin="0,0,0,10">
            <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox" Width="300" Padding="4,2" TextChanged="SearchBox_TextChanged" />
            <TextBlock x:Name="SearchResultText" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="Gray" />
        </StackPanel>

        <DataGrid x:Name="PlayersGrid" Grid.Row="3" Grid.Column="0" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" GridLinesVisibility="Horizontal" AlternatingRowBackground="#F5F5F5"
                  SelectionChanged="PlayersGrid_SelectionChanged" PreviewKeyDown="PlayersGrid_KeyDown">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" />
                <DataGridTextColumn Header="Name" Binding="{Binding Player.Name}" Width="150" />
                <DataGridTextColumn Header="Nationality" Binding="{Binding Player.Nationality}" Width="110" />
                <DataGridTextColumn Header="Position" Binding="{Binding Player.Position}" Width="70" />
                <DataGridTextColumn Header="Birth Year" Binding="{Binding Player.BirthYear}" Width="80" />
                <DataGridTextColumn Header="Retired" Binding="{Binding Player.Retired}" Width="60" />
                <DataGridTextColumn Header="Difficulty" Binding="{Binding Player.Difficulty}" Width="70" />
                <DataGridTextColumn Header="Clubs" Binding="{Binding Player.Clubs.Count}" Width="50" />
                <DataGridTextColumn Header="Issues" Binding="{Binding IssuesSummary}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#DDDDDD" />

        <DockPanel Grid.Row="3" Grid.Column="2" Margin="10,0,0,0">
            <TextBlock x:Name="ClubHistoryHeader" DockPanel.Dock="Top" Text="Select a player to see career history"
                       FontWeight="Bold" Margin="0,0,0,8" TextWrapping="Wrap" />
            <ListView x:Name="ClubHistoryList" DockPanel.Dock="Top">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#" Width="30" DisplayMemberBinding="{Binding Order}" />
                        <GridViewColumn Header="Club" Width="150" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="From" Width="60" DisplayMemberBinding="{Binding StartYear}" />
                        <GridViewColumn Header="To" Width="60" DisplayMemberBinding="{Binding EndYear}" />
                        <GridViewColumn Header="Loan" Width="60" DisplayMemberBinding="{Binding IsLoanDisplay}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</Window>
